{
  "name": "tiktok-api-gateway",
  "version": "1.0.0",
  "description": "API Gateway for TikTok-like social media platform",
  "main": "apiGateway.js",
  "scripts": {
    "start": "node apiGateway.js",
    "dev": "nodemon apiGateway.js",
    "test": "jest",
    "lint": "eslint .",
    "docker:build": "docker build -t tiktok-api-gateway .",
    "docker:run": "docker run -p 3000:3000 tiktok-api-gateway"
  },
  "keywords": [
    "api",
    "gateway",
    "microservices",
    "social-media",
    "express"
  ],
  "dependencies": {
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.0.2"
  },
  "devDependencies": {
    "eslint": "^9.34.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

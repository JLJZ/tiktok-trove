{
  "name": "user-service",
  "version": "1.0.0",
  "description": "User authentication and profile management service",
  "main": "dist/server.js",
  "scripts": {
    "build": "rimraf dist && tsc && tsc-alias",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx src/prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "docker:build": "docker build -t user-service .",
    "docker:run": "docker run -p 3002:3002 user-service"
  },
  "keywords": [
    "user",
    "authentication",
    "microservice",
    "express",
    "typescript",
    "prisma"
  ],
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "are-we-there-yet": "^4.0.2",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "gauge": "^5.0.2",
    "glob": "^11.0.3",
    "helmet": "^8.1.0",
    "inflight": "^1.0.6",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "npmlog": "^7.0.1",
    "rimraf": "^6.0.1",
    "typescript-eslint": "^8.41.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "jest": "^30.1.1",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4",
    "tsc-alias": "^1.8.10",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
